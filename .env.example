# Choose "formspree" or "emailjs".
VITE_FORM_PROVIDER=formspree

# Formspree: https://formspree.io/f/your-form-id
# EmailJS: https://api.emailjs.com/api/v1.0/email/send
VITE_FORM_ENDPOINT=

# Required only when VITE_FORM_PROVIDER=emailjs.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
